{
  "version": 1,
  "project_root": ".",
  "docs_root": "docs",
  "repositories": {
    "app": {"path": ".", "base_ref": "main", "worktree_root": "worktrees"}
  },
  "roles": {
    "product": {"skill": "m-discuss", "contexts": [], "sessions": [], "create": {"target": {"type": "project", "projectId": "<verified-project-id>", "environment": "worktree", "base_ref": "main"}}},
    "architect": {"skill": "m-plan", "contexts": [], "sessions": [], "create": {"target": {"type": "project", "projectId": "<verified-project-id>", "environment": "worktree", "base_ref": "main"}}},
    "executor": {"skill": "m-execute", "contexts": [], "sessions": [], "create": {"target": {"type": "project", "projectId": "<verified-project-id>", "environment": "worktree", "base_ref": "main"}}},
    "tester": {"skill": "m-test", "contexts": [], "sessions": [], "create": {"target": {"type": "project", "projectId": "<verified-project-id>", "environment": "worktree", "base_ref": "main"}}},
    "release": {"skill": "m-archive", "contexts": [], "sessions": [], "create": {"target": {"type": "project", "projectId": "<verified-project-id>", "environment": "worktree", "base_ref": "main"}}}
  },
  "stages": [
    {"id": "plan", "role": "architect", "after": [], "routing": "any"},
    {"id": "execute", "role": "executor", "after": ["plan"], "routing": "split"},
    {"id": "integrate", "role": "executor", "after": ["execute"], "routing": "join"},
    {"id": "test", "role": "tester", "after": ["integrate"], "routing": "join"},
    {"id": "archive", "role": "release", "after": ["test"], "routing": "any"}
  ],
  "limits": {"max_live": 6, "max_created": 12, "max_depth": 1, "max_nonprogress": 3, "reuse_after": 4}
}
